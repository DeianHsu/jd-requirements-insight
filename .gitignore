# Python
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
coverage.xml
htmlcov/

# Build
build/
dist/
*.egg-info/

# Environment
.env
.env.*
!.env.example
.venv/
.uv-python/
.uv-cache*/

# Logs and temporary files
*.log
*.tmp
*.bak
*.orig

# SQLite runtime files
*.db
*.db-wal
*.db-shm
*.db-journal

# 本地收集的真实招聘数据可能包含转载内容或个人筛选备注，不上传。
data/raw_jds/*
!data/raw_jds/.gitkeep
data/golden/jd_extractions/*
data/private/

# 本地生成的分析报告不默认上传（正式对外报告如需入库另行单独放开）。
reports/*
# P0-7 项目级历史风险接受记录（豁免 JD 1/2/3）需入库，供文档引用与追溯。
!reports/P0-7/
reports/P0-7/*
!reports/P0-7/legacy-extraction-waiver.json

# Reasonix 本地会话、记忆与配置，不上传
.reasonix/
reasonix.toml
